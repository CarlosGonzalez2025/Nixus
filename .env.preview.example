# Credenciales para scripts/ui-preview.mjs (capturas de pantalla de la app).
#
# Copie este archivo como `.env.preview` y complete los valores.
# `.env.preview` está en .gitignore: NUNCA se sube al repositorio.
#
#   cp .env.preview.example .env.preview        (bash)
#   Copy-Item .env.preview.example .env.preview (PowerShell)
#
# Use una cuenta con rol `admin`: es la única que ve el dashboard completo,
# incluida la sección de Planeación SST (workPlans está restringido a admin
# en firestore.rules).
#
# El script solo navega y toma capturas — no crea, edita ni elimina registros.

PREVIEW_EMAIL=
PREVIEW_PASSWORD=

# Opcional: cambiar si el servidor de desarrollo corre en otro puerto.
# PREVIEW_BASE_URL=http://localhost:9003
