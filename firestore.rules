
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Funciones de Ayuda ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      let data = getUserData();
      return data.role == role || (data.otherRoles != null && role in data.otherRoles);
    }

    function isAdmin() {
      return isSignedIn() && hasRole('admin');
    }

    function isLiderRegional() {
      return isSignedIn() && hasRole('lider_regional');
    }

    // Admin o Líder Regional (para operaciones de gestión).
    // El scope del lider_regional se valida en el cliente; aquí solo se verifica el rol.
    function isAdminOrLR() {
      return isAdmin() || isLiderRegional();
    }

    // Determina si un permiso activa la firma de Mantenimiento/Aislador Competente.
    // Espeja la lógica de requiresMaintenanceSignature() en actions.ts para mantener
    // consistencia: ambos campos (controlEnergia y selectedWorkTypes.energia) activan el requisito.
    function requiresMaintenanceSign(data) {
      return data.controlEnergia == true ||
        (data.keys().hasAny(['selectedWorkTypes']) &&
         data.selectedWorkTypes.get('energia', false) == true);
    }

    function isCreator(permit) {
      return request.auth.uid == permit.createdBy;
    }

    function hasAnyRole(roles) {
      let data = getUserData();
      return (data.role in roles) || (data.otherRoles != null && data.otherRoles.hasAny(roles));
    }

    // Devuelve el campo 'empresa' del usuario.
    function getEmpresa() {
      return getUserData().empresa;
    }

    // Devuelve el campo 'planta' del usuario.
    function getPlanta() {
      return getUserData().planta;
    }

    // Módulo Hallazgos: admins, líderes SST y autorizantes.
    // FIX 1A: Eliminado hardcoding de 'Nixus Capital'. El acceso por empresa se controla
    // individualmente en match /hallazgos/{hallazgoId} comparando resource.data.empresaId == getEmpresa().
    function canAccessHallazgos() {
      return isSignedIn() && (isAdminOrLR() || hasRole('lider_sst') || hasRole('autorizante'));
    }

    // --- Colección de Usuarios (users) ---
    match /users/{userId} {
      allow read: if isAdminOrLR() || (isSignedIn() && request.auth.uid == userId);
      allow list: if isAdminOrLR();
      allow update: if isOwner(userId) || isAdminOrLR();
      allow create, delete: if false;
    }

    // --- Colección de Notificaciones (notifications) ---
    match /notifications/{notificationId} {
      // Un usuario puede leer y listar sus propias notificaciones.
      allow read, list: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Un usuario puede actualizar su propia notificación, pero solo para marcarla como leída.
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);

      // La creación y eliminación de notificaciones solo se hacen desde el backend.
      allow create, delete: if false;
    }

    // --- Colección de Permisos (permits) ---
    match /permits/{permitId} {
      // LECTURA: Permite leer a los involucrados directamente.
      allow read: if isSignedIn() &&
                    (isAdmin() ||
                     isCreator(resource.data) ||
                     // Autorizante: puede leer permisos de su empresa y planta
                     (hasRole('autorizante') &&
                       (!getEmpresa() || resource.data.generalInfo.empresa == getEmpresa()) &&
                       (!getPlanta()  || resource.data.generalInfo.planta  == getPlanta())) ||
                     // Líder SST: puede leer permisos de su empresa y planta
                     (hasRole('lider_sst') &&
                       (!getEmpresa() || resource.data.generalInfo.empresa == getEmpresa()) &&
                       (!getPlanta()  || resource.data.generalInfo.planta  == getPlanta())) ||
                     (hasRole('mantenimiento') && requiresMaintenanceSign(resource.data))
                    );

      // LISTA: Permite listar a roles que ven todo y a usuarios que solo ven lo suyo.
      // NOTE 1B: Firestore Security Rules v2 no soporta inspección de filtros where() de la query
      // para campos anidados (ej: generalInfo.empresa). Por ello, la restricción por empresa/planta
      // para 'autorizante' y 'lider_sst' NO puede aplicarse aquí. La protección real está en:
      //   (a) La regla `allow read` que sí evalúa resource.data por documento individual.
      //   (b) Los filtros cliente en dashboard/page.tsx, permits/page.tsx y use-sidebar-badges.ts.
      // TODO: Si se migra a Firestore Rules v2 con request.query.filters, agregar validación de empresa/planta.
      allow list: if isSignedIn() &&
                  (
                    isAdmin() || isLiderRegional() ||
                    hasRole('autorizante') || hasRole('lider_sst') ||
                    hasRole('solicitante') ||
                    hasRole('mantenimiento')
                  );

      // CREAR/ELIMINAR: Nunca se permite desde el cliente, solo vía Server Actions.
      allow create, delete: if false;

      // ACTUALIZAR: La lógica más compleja, define quién puede modificar el permiso y en qué estado.
      allow update: if isSignedIn() &&
                    (
                      // El creador puede editarlo solo si está en estado 'borrador'.
                      (isCreator(resource.data) && resource.data.status == 'borrador') ||

                      // Un admin o lider_regional puede cambiar el estado en cualquier momento.
                      (isAdminOrLR()) ||

                      // Lógica de firmas de apertura: permite firmar si el permiso está pendiente.
                      (resource.data.status == 'pendiente_revision') ||

                      // Lógica para CIERRE DE EMERGENCIA: Permite a roles autorizados forzar el cierre.
                      (
                        request.resource.data.status == 'cerrado' &&
                        ['pendiente_revision', 'aprobado', 'en_ejecucion', 'suspendido'].hasAny([resource.data.status]) &&
                        hasAnyRole(['solicitante', 'autorizante', 'lider_sst', 'admin'])
                      ) ||

                      // Lógica de firmas de validación y cierre diario: permite actualizar los anexos si está en ejecución.
                      (
                        (resource.data.status == 'en_ejecucion' || resource.data.status == 'suspendido') &&
                        hasAnyRole(['solicitante', 'admin', 'autorizante']) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasAny(['anexoAltura', 'anexoConfinado', 'anexoIzaje', 'anexoExcavaciones', 'anexoEnergias', 'workers', 'closure'])
                      ) ||

                      // Lógica de cierre final: permite a los roles autorizados cambiar el estado a 'cerrado'
                      // si el permiso está en ejecución o suspendido.
                      (request.resource.data.status == 'cerrado' &&
                       (resource.data.status == 'en_ejecucion' || resource.data.status == 'suspendido') &&
                       hasAnyRole(['solicitante', 'admin'])) ||

                      // Lógica de suspensión y reactivación
                      (request.resource.data.status == 'suspendido' && resource.data.status == 'en_ejecucion' && hasAnyRole(['lider_sst', 'admin'])) ||
                      (request.resource.data.status == 'en_ejecucion' && resource.data.status == 'suspendido' && hasAnyRole(['lider_sst', 'admin'])) ||

                      // Lógica de rechazo: permite a roles de aprobación rechazar un permiso.
                      (request.resource.data.status == 'rechazado' && resource.data.status == 'pendiente_revision' && hasAnyRole(['autorizante', 'lider_sst', 'admin']))
                    );
    }

    // --- Colección de Listas Dinámicas (dynamic_lists) ---
    match /dynamic_lists/{listName} {
      allow read: if isSignedIn();
      allow write: if isAdminOrLR();
    }

    // --- Módulo Verificación Contratistas ---

    // Módulo visible para: admin, lider_sst, asesor_arl.
    function canAccessContractorModule() {
      return isSignedIn() && (isAdminOrLR() || hasRole('lider_sst') || hasRole('asesor_arl'));
    }

    // Valida acceso de lectura a una verificación según el rol:
    // - Admin: ve todo.
    // - Asesor ARL: solo las que él creó.
    // - Líder SST: solo las de su planta (plantId == user.planta).
    function canReadVerification(verif) {
      return isAdmin()
        || (hasRole('asesor_arl') && verif.createdBy == request.auth.uid)
        || (hasRole('lider_sst') && verif.plantId == getPlanta());
    }

    // Tipos de riesgo: solo lectura para el módulo, escritura para admin y asesor_arl.
    match /riskTypes/{riskTypeId} {
      allow read: if canAccessContractorModule();
      allow write: if isAdmin() || hasRole('asesor_arl');
    }

    // Plantillas de verificación y sus grupos (ítems inline en el grupo).
    // - Admin: acceso completo de lectura y escritura.
    // - Asesor ARL: puede crear plantillas propias; solo edita/elimina las que él creó.
    // - Lider SST y resto del módulo: solo lectura.
    match /checklistTemplates/{templateId} {
      allow read: if canAccessContractorModule();
      allow create: if isAdmin()
                    || (hasRole('asesor_arl') && request.resource.data.createdBy == request.auth.uid);
      allow update: if isAdmin()
                    || (hasRole('asesor_arl') && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin()
                    || (hasRole('asesor_arl') && resource.data.createdBy == request.auth.uid);

      match /groups/{groupId} {
        allow read: if canAccessContractorModule();
        // Escritura en grupos solo si el usuario puede editar la plantilla padre.
        allow write: if isAdmin()
                     || (hasRole('asesor_arl') &&
                         get(/databases/$(database)/documents/checklistTemplates/$(templateId)).data.createdBy == request.auth.uid);
      }
    }

    // Verificaciones de contratistas.
    match /contractorVerifications/{verificationId} {
      // Lectura individual: validación por documento.
      allow get: if canAccessContractorModule() && canReadVerification(resource.data);

      // Listado: el filtro where() del cliente restringe los registros visibles.
      // La protección real es la regla `allow get` aplicada por documento.
      allow list: if canAccessContractorModule();

      // Crear: solo si el campo createdBy coincide con el usuario autenticado.
      allow create: if canAccessContractorModule()
                    && request.resource.data.createdBy == request.auth.uid;

      // Actualizar: mismo criterio de acceso que lectura.
      allow update: if canAccessContractorModule() && canReadVerification(resource.data);

      // Eliminar: solo admin.
      allow delete: if isAdminOrLR();

      // Subcolección: respuestas (answers).
      match /answers/{answerId} {
        allow read, write: if canAccessContractorModule()
          && canReadVerification(
               get(/databases/$(database)/documents/contractorVerifications/$(verificationId)).data
             );
      }

      // Subcolección: evidencias (evidences).
      match /evidences/{evidenceId} {
        allow read, write: if canAccessContractorModule()
          && canReadVerification(
               get(/databases/$(database)/documents/contractorVerifications/$(verificationId)).data
             );
      }

      // Subcolección: planes de acción (actionPlans).
      match /actionPlans/{actionPlanId} {
        allow read, write: if canAccessContractorModule()
          && canReadVerification(
               get(/databases/$(database)/documents/contractorVerifications/$(verificationId)).data
             );
      }
    }

    // --- Colección de Hallazgos (hallazgos) ---
    match /hallazgos/{hallazgoId} {

      // NUEVO: Asesor ARL — acceso exclusivo a sus propios hallazgos (filtro por createdBy).
      // Estos bloques se evalúan con OR lógico junto a los de abajo.
      // El filtro de lista lo aplica el cliente con where('createdBy', '==', uid).
      allow get:    if isSignedIn() && hasRole('asesor_arl') && resource.data.createdBy == request.auth.uid;
      allow list:   if isSignedIn() && hasRole('asesor_arl');
      allow create: if isSignedIn() && hasRole('asesor_arl') && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && hasRole('asesor_arl') && resource.data.createdBy == request.auth.uid;

      // GET (documento individual): resource.data siempre disponible.
      allow get: if canAccessHallazgos() &&
                 (isAdmin() ||
                  // Autorizante y otros: empresa debe coincidir; si tiene planta, también debe coincidir
                  (resource.data.empresaId == getEmpresa() &&
                   (!getPlanta() || resource.data.planta == getPlanta())) ||
                  // Líder SST: empresa Y planta deben coincidir
                  (hasRole('lider_sst') &&
                   resource.data.empresaId == getEmpresa() &&
                   (!getPlanta() || resource.data.planta == getPlanta())));

      // LIST (queries): el filtro por planta/empresa lo garantiza el where() del cliente.
      // NOTA: resource.data NO está disponible en reglas 'list' (solo en 'get'). La restricción
      // por empresa se aplica solo mediante where() del cliente y en 'allow get' por documento.
      allow list: if canAccessHallazgos();

      // Creación: empresa debe coincidir con la del usuario.
      allow create: if canAccessHallazgos() &&
                    (isAdmin() ||
                     request.resource.data.empresaId == getEmpresa() ||
                     hasRole('lider_sst'));

      // Actualización: empresa Y planta deben coincidir.
      allow update: if canAccessHallazgos() &&
                    (isAdmin() ||
                     (resource.data.empresaId == getEmpresa() &&
                      (!getPlanta() || resource.data.planta == getPlanta())));

      allow delete: if isAdminOrLR();
    }

    // --- Módulo Confinados: Diagnóstico (diagnosticosConfinados) ---
    match /diagnosticosConfinados/{docId} {

      // Roles con acceso al módulo
      function canAccessConfinados() {
        return isSignedIn() && (
          isAdminOrLR() ||
          hasRole('lider_sst') ||
          hasRole('asesor_arl') ||
          hasRole('autorizante')
        );
      }

      // Lectura individual
      allow get: if canAccessConfinados() && (
        isAdminOrLR() ||
        hasRole('lider_sst') ||
        (hasRole('asesor_arl') && resource.data.createdById == request.auth.uid) ||
        (hasRole('autorizante') && resource.data.createdById == request.auth.uid)
      );

      // Listado (la restricción fina la aplica el cliente con where/filtros)
      allow list: if canAccessConfinados();

      // Creación: el campo createdById debe coincidir con el usuario que firma la petición
      allow create: if canAccessConfinados()
                    && request.resource.data.createdById == request.auth.uid;

      // Actualización: el creador o admin/lider pueden editar
      allow update: if canAccessConfinados() && (
        isAdminOrLR() ||
        hasRole('lider_sst') ||
        resource.data.createdById == request.auth.uid
      );

      // Eliminación: solo admin / líder regional
      allow delete: if isAdminOrLR();
    }

    // --- Módulo Alturas: Diagnóstico (diagnosticosAlturas) ---
    match /diagnosticosAlturas/{docId} {

      // Mismos roles que Confinados: admin, lider_regional, lider_sst, asesor_arl, autorizante
      function canAccessAlturas() {
        return isSignedIn() && (
          isAdminOrLR() ||
          hasRole('lider_sst') ||
          hasRole('asesor_arl') ||
          hasRole('autorizante')
        );
      }

      // Lectura individual:
      // - Admin / Líder Regional: acceso total
      // - Líder SST: acceso total (gestiona todos los registros de su planta)
      // - Asesor ARL / Autorizante: solo los que él mismo creó
      allow get: if canAccessAlturas() && (
        isAdminOrLR() ||
        hasRole('lider_sst') ||
        (hasRole('asesor_arl')  && resource.data.createdById == request.auth.uid) ||
        (hasRole('autorizante') && resource.data.createdById == request.auth.uid)
      );

      // Listado: acceso habilitado para todos los roles del módulo.
      // El filtro fino por empresa/planta lo aplica el cliente con where() + onSnapshot.
      allow list: if canAccessAlturas();

      // Creación: el campo createdById debe coincidir con el usuario autenticado.
      // Los registros importados vía Admin SDK (scripts) omiten esta regla.
      allow create: if canAccessAlturas()
                    && request.resource.data.createdById == request.auth.uid;

      // Actualización: el creador o un rol de gestión puede editar.
      allow update: if canAccessAlturas() && (
        isAdminOrLR() ||
        hasRole('lider_sst') ||
        resource.data.createdById == request.auth.uid
      );

      // Eliminación: solo admin / líder regional.
      allow delete: if isAdminOrLR();
    }

    // --- Módulo Planeación SST: Plan de Trabajo Anual (workPlans) ---
    // Acceso EXCLUSIVO para administradores (reutiliza el helper isAdmin()).
    function canAccessWorkPlans() { return isAdmin(); }

    match /workPlans/{planId} {
      allow read, list: if canAccessWorkPlans();
      // create permitido desde cliente para soportar offline; createdBy == uid.
      allow create: if canAccessWorkPlans()
                    && request.resource.data.createdBy == request.auth.uid;
      // update incluye recálculo de agregados y cierre; no reasignar createdBy.
      allow update: if canAccessWorkPlans()
                    && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin();

      match /tasks/{taskId} {
        allow read, list: if canAccessWorkPlans();
        allow create, update, delete: if canAccessWorkPlans()
          && exists(/databases/$(database)/documents/workPlans/$(planId));
      }
    }

  }
}
